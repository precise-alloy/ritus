{
  "description": "Ritus companion plugin bootstrap",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/scripts/companion-bootstrap.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}